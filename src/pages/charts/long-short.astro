---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="crypto, metals & index long/short ratio"
  description="n0brains live long/short positioning — real on-chain DEX longs vs shorts by price point for BTC & ETH, plus CFTC Commitments-of-Traders managed-money / large-speculator positioning for gold, silver, copper, WTI & Brent oil, and the S&P 500 and Nasdaq-100. Free, live. Not financial advice."
>
  <section class="about-section ls-wide">
    <a href="/charts" class="ls-back">← charts</a>
    <p class="ls-kicker"><span class="ls-livedot"></span>Real positioning · live · <a href="/charts/liqmap" class="ls-accent" style="text-decoration:underline">liquidation map →</a></p>
    <h1 class="ls-h1">LONG / SHORT<br /><span class="ls-accent">RATIO</span></h1>
    <p class="legal-updated">
      Who is positioned which way. For <strong>BTC &amp; ETH</strong> we read
      <em>real</em> on-chain DEX positions (Hyperliquid + GMX) and split the
      notional into longs vs shorts at every price level. For <strong>metals,
      oil and the equity indices</strong> we read <strong>CFTC Commitments of
      Traders</strong> — the weekly long/short of managed money (commodities) and
      large speculators (indices), the deepest real positioning that exists for
      those markets. Free and live. Analytical data,
      <strong>not financial advice</strong>.
    </p>

    <div class="ls-controls">
      <div id="ls-coins" class="ls-tabs" role="tablist" aria-label="asset"></div>
      <div id="ls-range" class="ls-tabs" role="tablist" aria-label="trend range">
        <button data-days="1" role="tab">24h</button>
        <button data-days="7" class="active" role="tab">7d</button>
        <button data-days="30" role="tab">30d</button>
        <button data-days="90" role="tab">max</button>
      </div>
    </div>

    <div id="ls-banner" class="proof-banner proof-loading" role="status">
      <span class="dot"></span><span class="banner-text">loading long/short…</span>
    </div>

    <div id="ls-srcline" class="ls-srcline" hidden></div>

    <div id="ls-head" class="ls-head" hidden>
      <div class="ls-splitbar">
        <div id="ls-long" class="ls-seg ls-seg-long"><span id="ls-long-lbl"></span></div>
        <div id="ls-short" class="ls-seg ls-seg-short"><span id="ls-short-lbl"></span></div>
      </div>
      <div class="ls-headmeta">
        <span><b id="ls-ratio">—</b> long/short ratio</span>
        <span id="ls-m1" class="ls-mLong">—</span>
        <span id="ls-m2" class="ls-mShort">—</span>
        <span id="ls-m3" class="ls-muted"></span>
      </div>
    </div>

    <div id="ls-wrap" class="ls-wrap">
      <canvas id="ls-canvas" class="ls-canvas"></canvas>
      <div id="ls-tip" class="ls-tip"></div>
    </div>
    <p class="meta" id="ls-meta"></p>

    <div id="ls-ctx" class="ls-ctx" hidden></div>
    <p class="ls-disclaimer" id="ls-disclaimer"></p>

    <div class="ls-upsell">
      <p>
        <strong>Want this in your agent or bot?</strong> Real DEX long/short by
        price point (BTC/ETH) and CFTC COT positioning (metals, oil, indices) are
        on the <a href="/signup">n0brains API</a> via REST &amp; the MCP server.
      </p>
      <p class="ls-endpoints">
        <code>/charts/long-short/{'{coin}'}</code> · <code>/positioning/{'{coin}'}</code>
        — <a href="/docs">docs</a>
      </p>
      <a class="ls-cta" href="/signup">Get API access →</a>
    </div>
  </section>

  <style is:global>
    .about-section.ls-wide { max-width: 1100px; }
    .ls-back { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); text-decoration: none; }
    .ls-back:hover { color: var(--accent); }
    .ls-kicker { font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase;
      letter-spacing: 0.2em; color: var(--accent); margin: 1rem 0; display: flex; align-items: center; gap: 0.6rem; }
    .ls-livedot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
      box-shadow: 0 0 8px var(--accent); display: inline-block; animation: ls-blink 2s infinite; }
    @keyframes ls-blink { 50% { opacity: 0.3; } }
    .ls-h1 { font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, 4.6rem);
      line-height: 0.92; color: var(--text-heading); margin-bottom: 1rem; }
    .ls-accent { color: var(--accent); }
  </style>
  <style>
    .ls-controls { display:flex; gap:1.1rem; flex-wrap:wrap; align-items:center; margin:1.75rem 0 .8rem; }
    .ls-tabs { display:flex; gap:.4rem; flex-wrap:wrap; }
    .ls-tabs :global(button) {
      background:var(--bg-card,#0d0d0d); border:1px solid var(--border,#1a1a1a);
      color:var(--text-muted,#707070); padding:.4rem .8rem; border-radius:7px;
      cursor:pointer; font-size:.82rem; font-family:var(--font-mono,inherit); line-height:1;
      transition:background .12s,border-color .12s,color .12s;
    }
    .ls-tabs :global(button:hover) { border-color:var(--accent,#00ff41); color:var(--text-heading,#efefef); }
    .ls-tabs :global(button.active) { background:var(--accent,#00ff41); color:#000; font-weight:700; border-color:var(--accent,#00ff41); }
    .ls-tabs :global(.ls-grp) { align-self:center; font-size:.62rem; letter-spacing:.12em; text-transform:uppercase;
      color:#5a5f6b; font-family:var(--font-mono); padding:0 .1rem 0 .5rem; border:none; background:none; cursor:default; }
    @media (pointer:coarse) { .ls-tabs :global(button) { padding:.55rem .9rem; min-height:40px; } }

    .ls-srcline { font-size:.74rem; font-family:var(--font-mono); color:#9aa0ad; margin:.2rem 0 .7rem;
      display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .ls-srcpill { padding:2px 8px; border-radius:100px; border:1px solid var(--border-accent,#2a4a30);
      color:var(--accent,#3fd07f); font-size:.66rem; letter-spacing:.06em; text-transform:uppercase; }
    .ls-srcpill.cot { color:#d9b44a; border-color:#5a4a20; }

    .ls-head { margin:.3rem 0 1rem; }
    .ls-splitbar { display:flex; width:100%; height:38px; border-radius:8px; overflow:hidden;
      border:1px solid #2a2a3a; background:#14121f; }
    .ls-seg { display:flex; align-items:center; min-width:0; transition:width .5s ease; }
    .ls-seg-long { background:linear-gradient(90deg,#0f7a3f,#1fbf6b); justify-content:flex-start; padding-left:.7rem; }
    .ls-seg-short { background:linear-gradient(90deg,#c23b34,#8c1f1c); justify-content:flex-end; padding-right:.7rem; }
    .ls-seg span { font-size:.82rem; font-weight:700; color:#fff; font-variant-numeric:tabular-nums; white-space:nowrap;
      text-shadow:0 1px 2px rgba(0,0,0,.4); }
    .ls-headmeta { display:flex; gap:1.3rem; flex-wrap:wrap; margin-top:.55rem; font-size:.82rem;
      color:#cfd2dc; font-family:var(--font-mono); align-items:baseline; }
    .ls-headmeta b { color:#fff; font-size:1.05rem; }
    .ls-mLong { color:#3fd07f; } .ls-mShort { color:#ff6f66; }
    .ls-muted { color:#6b7280; }

    .ls-wrap { width:100%; margin-top:.25rem; min-height:160px; position:relative; }
    .ls-canvas { display:block; width:100%; height:auto; border-radius:6px; background:#0d0b1a;
      cursor:crosshair; -webkit-user-select:none; user-select:none; touch-action:none; }
    .ls-tip { display:none; position:absolute; pointer-events:none; z-index:5; background:rgba(15,13,28,0.96);
      border:1px solid #3a3a4a; border-radius:7px; padding:.5rem .7rem; font-size:.74rem;
      color:#e3e6ee; line-height:1.5; white-space:nowrap; box-shadow:0 4px 14px rgba(0,0,0,0.5); }
    .ls-tip .k { color:#9aa0ad; } .ls-tip b { color:#fff; font-variant-numeric:tabular-nums; }

    .ls-ctx { display:grid; grid-template-columns:repeat(3,1fr); gap:.9rem; margin-top:1.1rem; }
    @media (max-width:820px) { .ls-ctx { grid-template-columns:1fr; } }
    .ls-card { border:1px solid var(--border,#242433); border-radius:9px; padding:.8rem .9rem; background:rgba(255,255,255,.015); }
    .ls-card-t { font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; color:#8b909c; font-family:var(--font-mono); margin-bottom:.45rem; }
    .ls-tag { color:#6b7280; text-transform:none; letter-spacing:0; font-style:italic; }
    .ls-card-v { font-size:1.3rem; font-weight:700; color:#efefef; font-variant-numeric:tabular-nums; }
    .ls-card-sub { font-size:.74rem; color:#9aa0ad; margin-top:.25rem; line-height:1.5; }
    .ls-oi { display:flex; flex-direction:column; gap:.4rem; }
    .ls-oi-row { display:grid; grid-template-columns:96px 1fr auto; align-items:center; gap:.6rem; font-size:.74rem; font-family:var(--font-mono); }
    .ls-oi-name { color:#cfd2dc; white-space:nowrap; } .ls-oi-usd { color:#9aa0ad; white-space:nowrap; }
    .ls-oi-barwrap { height:8px; background:#1a1a24; border-radius:4px; overflow:hidden; }
    .ls-oi-bar { height:8px; border-radius:4px; background:linear-gradient(90deg,#3a5bd0,#5b8cff); }

    .ls-disclaimer { font-size:.72rem; color:#6b7280; margin-top:.8rem; max-width:82ch; }
    .ls-upsell { margin-top:2rem; padding:1.25rem 1.5rem; border:1px solid var(--border,#2a2a3a);
      border-radius:10px; background:rgba(91,140,255,0.05); max-width:74ch; }
    .ls-upsell p { margin:0 0 .6rem; font-size:.9rem; color:#cfd2dc; }
    .ls-upsell .ls-endpoints { font-size:.74rem; color:#9aa0ad; }
    .ls-upsell code { font-size:.72rem; color:#8fb3ff; }
    .ls-cta { display:inline-block; margin-top:.4rem; background:var(--accent,#5b8cff);
      color:#fff; padding:.5rem 1rem; border-radius:7px; font-size:.85rem; font-weight:600; text-decoration:none; }
    .ls-cta:hover { filter:brightness(1.1); }
    .proof-banner.proof-ok .dot { background:#2ecc71; }
  </style>

  <script is:inline>
  (function () {
    "use strict";
    const API = "https://api.n0brains.com";
    // Only assets with a REAL long/short source: BTC/ETH (deep DEX) +
    // metals/energy/indices (CFTC COT). Single-name stocks dropped — no
    // meaningful positioning source exists for them.
    const GROUPS = [
      ["crypto", ["BTC", "ETH"]],
      ["metals", ["GOLD", "SILVER", "COPPER"]],
      ["energy", ["OIL", "BRENTOIL"]],
      ["index",  ["SP500", "NASDAQ"]],
    ];
    const LABEL = { OIL: "WTI", BRENTOIL: "BRENT", SP500: "S&P 500", NASDAQ: "NASDAQ" };
    const REFRESH_MS = 60000;
    let coin = "BTC", days = 7, timer = null, reqId = 0, last = null, resizeT = null;

    const $ = (id) => document.getElementById(id);
    const fmtPx = (p) => {
      p = +p;
      if (p >= 1000) return "$" + p.toLocaleString(undefined, { maximumFractionDigits: 0 });
      if (p >= 1)    return "$" + p.toFixed(2);
      return "$" + p.toPrecision(3);
    };
    const fmtUsd = (n) => {
      n = Math.abs(+n || 0);
      if (n >= 1e9) return "$" + (n/1e9).toFixed(2) + "B";
      if (n >= 1e6) return "$" + (n/1e6).toFixed(1) + "M";
      if (n >= 1e3) return "$" + (n/1e3).toFixed(0) + "K";
      return "$" + n.toFixed(0);
    };
    const fmtNum = (n) => Math.round(+n || 0).toLocaleString();
    const pct = (x) => (x == null ? "—" : (x * 100).toFixed(1) + "%");

    function buildCoins() {
      let html = "";
      for (const [g, arr] of GROUPS) {
        html += `<span class="ls-grp">${g}</span>`;
        html += arr.map((c) =>
          `<button data-coin="${c}" role="tab" class="${c===coin?'active':''}">${LABEL[c]||c}</button>`).join("");
      }
      $("ls-coins").innerHTML = html;
      $("ls-coins").querySelectorAll("button[data-coin]").forEach((b) =>
        b.addEventListener("click", () => { coin = b.dataset.coin; sel(); load(); }));
    }
    function bindRange() {
      $("ls-range").querySelectorAll("button").forEach((b) =>
        b.addEventListener("click", () => { days = +b.dataset.days; sel(); load(); }));
    }
    function sel() {
      $("ls-coins").querySelectorAll("button[data-coin]").forEach((b) =>
        b.classList.toggle("active", b.dataset.coin === coin));
      $("ls-range").querySelectorAll("button").forEach((b) =>
        b.classList.toggle("active", +b.dataset.days === days));
    }
    function banner(state, text) {
      const b = $("ls-banner");
      b.className = "proof-banner " + state;
      b.querySelector(".banner-text").textContent = text;
    }

    // ── headline split bar (works for both DEX and COT) ──
    function renderHead(longPct, shortPct, ratio, m1, m2, m3) {
      if (longPct == null) { $("ls-head").hidden = true; return; }
      $("ls-head").hidden = false;
      const sp = shortPct != null ? shortPct : (1 - longPct);
      $("ls-long").style.width = (longPct * 100) + "%";
      $("ls-short").style.width = (sp * 100) + "%";
      $("ls-long-lbl").textContent = "LONG " + pct(longPct);
      $("ls-short-lbl").textContent = pct(sp) + " SHORT";
      $("ls-ratio").textContent = ratio != null ? (+ratio).toFixed(2) : "—";
      $("ls-m1").textContent = m1; $("ls-m2").textContent = m2; $("ls-m3").textContent = m3 || "";
    }

    function srcline(mode, d) {
      const el = $("ls-srcline"); el.hidden = false;
      if (mode === "cot") {
        const cat = d.cot.category, rd = d.cot.report_date;
        el.innerHTML = `<span class="ls-srcpill cot">CFTC COT</span> `
          + `${cat} positioning · weekly (reported ${rd}, ~3d lag) · the deepest real long/short for this market`;
      } else {
        let s = `<span class="ls-srcpill">DEX · real</span> live on-chain positions (Hyperliquid + GMX), by price point`;
        if (d.cot) s += ` · <span class="ls-srcpill cot" style="margin-left:.3rem">COT lens</span> spec net ${d.cot.net_pct_of_oi>0?"+":""}${d.cot.net_pct_of_oi}% of OI`;
        el.innerHTML = s;
      }
    }

    // ── DEX mode: diverging bars by price ──
    function renderDexChart(d) {
      const canvas = $("ls-canvas"), wrap = $("ls-wrap");
      const buckets = (d.buckets || []).filter((b) => (b.long_usd + b.short_usd) > 0);
      const ctx = canvas.getContext("2d");
      const W = Math.max(360, Math.floor(wrap.clientWidth || 1000));
      if (!buckets.length) {
        canvas.width = W; canvas.height = 160; canvas.style.width="100%"; canvas.style.height="auto";
        ctx.fillStyle = "#0d0b1a"; ctx.fillRect(0,0,W,160);
        ctx.fillStyle = "#6b7280"; ctx.font = "14px system-ui";
        ctx.fillText("No DEX positions for " + d.coin + " yet.", 24, 84);
        $("ls-meta").textContent = ""; return;
      }
      const cur = d.current_price || buckets[Math.floor(buckets.length/2)].price;
      const prices = buckets.map((b) => b.price);
      const pmin0 = Math.min(...prices), pmax0 = Math.max(...prices);
      let vmin = pmin0, vmax = pmax0;
      const total = buckets.reduce((a,b)=>a+b.long_usd+b.short_usd,0) || 1;
      for (const p of [0.06,0.12,0.25,0.5]) {
        const lo = cur*(1-p), hi = cur*(1+p);
        let m=0; for (const b of buckets) if (b.price>=lo&&b.price<=hi) m+=b.long_usd+b.short_usd;
        if (m >= 0.6*total) { vmin=Math.max(pmin0,lo); vmax=Math.min(pmax0,hi); break; }
      }
      const vspan = (vmax-vmin)||1;
      const vis = buckets.filter((b)=>b.price>=vmin&&b.price<=vmax);
      const maxSide = Math.max(1, ...vis.map((b)=>Math.max(b.long_usd,b.short_usd)));
      const padT=18, padB=22, padL=64, padR=64;
      const H = Math.max(320, Math.min(680, vis.length*9 + padT + padB));
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = W*dpr; canvas.height = H*dpr; canvas.style.width="100%"; canvas.style.height="auto";
      ctx.setTransform(dpr,0,0,dpr,0,0);
      ctx.fillStyle="#0d0b1a"; ctx.fillRect(0,0,W,H);
      const plotW=W-padL-padR, plotH=H-padT-padB, cx=padL+plotW/2;
      const yOf=(p)=>padT+(vmax-p)/vspan*plotH;
      const halfMax=plotW/2-6, bh=Math.max(2, plotH/Math.max(vis.length,1)*0.8);
      last._geom={padL,padT,plotW,plotH,cx,vmin,vmax,vspan,maxSide,halfMax,W,H,mode:"dex"};
      ctx.strokeStyle="rgba(255,255,255,0.18)"; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(cx,padT); ctx.lineTo(cx,padT+plotH); ctx.stroke();
      for (const b of vis) {
        const y=yOf(b.price)-bh/2;
        if (b.short_usd>0){const w=(b.short_usd/maxSide)*halfMax; ctx.fillStyle="rgba(226,80,72,0.9)"; ctx.fillRect(cx-w,y,w,bh);}
        if (b.long_usd>0){const w=(b.long_usd/maxSide)*halfMax; ctx.fillStyle="rgba(31,191,107,0.92)"; ctx.fillRect(cx,y,w,bh);}
      }
      if (cur>=vmin&&cur<=vmax){const py=yOf(cur);
        ctx.save(); ctx.setLineDash([5,4]); ctx.strokeStyle="rgba(255,255,255,0.6)"; ctx.lineWidth=1;
        ctx.beginPath(); ctx.moveTo(padL,py); ctx.lineTo(padL+plotW,py); ctx.stroke(); ctx.setLineDash([]);
        const lbl=fmtPx(cur); ctx.font="bold 11px system-ui"; const tw=ctx.measureText(lbl).width;
        ctx.fillStyle="rgba(255,255,255,0.92)"; ctx.fillRect(cx-tw/2-6,py-9,tw+12,18);
        ctx.fillStyle="#0d0b1a"; ctx.textAlign="left"; ctx.fillText(lbl,cx-tw/2,py+4); ctx.restore();}
      ctx.font="11px system-ui"; ctx.textAlign="right"; ctx.fillStyle="#8b909c";
      const niceStep=(r,t)=>{const raw=r/t,mag=Math.pow(10,Math.floor(Math.log10(raw)));for(const m of[1,2,2.5,5,10])if(raw<=m*mag)return m*mag;return 10*mag;};
      const step=niceStep(vspan,7);
      for(let p=Math.ceil(vmin/step)*step;p<vmax;p+=step){const py=yOf(p);
        ctx.fillStyle="rgba(255,255,255,0.06)"; ctx.fillRect(padL,py,plotW,0.5);
        ctx.fillStyle="#8b909c"; ctx.fillText(fmtPx(p),padL-6,py+3);}
      ctx.textAlign="center"; ctx.font="bold 11px system-ui";
      ctx.fillStyle="#ff6f66"; ctx.fillText("◀ SHORT", padL+plotW*0.25, padT-4);
      ctx.fillStyle="#3fd07f"; ctx.fillText("LONG ▶", padL+plotW*0.75, padT-4);
      const asOf = d.as_of ? new Date(d.as_of*1000) : null;
      $("ls-meta").innerHTML = `<strong>${d.coin}</strong> · real DEX positions (HL+GMX) · `
        + `${vis.length} price levels · window ${fmtPx(vmin)}–${fmtPx(vmax)}`
        + (asOf ? ` · ${asOf.toLocaleTimeString()}` : "");
    }

    // ── COT mode: weekly long-share trend line ──
    function renderCotChart(d) {
      const canvas = $("ls-canvas"), wrap = $("ls-wrap");
      const tr = (d.cot && d.cot.trend || []).filter((p)=>p.long_pct!=null);
      const ctx = canvas.getContext("2d");
      const W = Math.max(360, Math.floor(wrap.clientWidth || 1000));
      const H = 360, padT=22, padB=30, padL=52, padR=16;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width=W*dpr; canvas.height=H*dpr; canvas.style.width="100%"; canvas.style.height="auto";
      ctx.setTransform(dpr,0,0,dpr,0,0); ctx.fillStyle="#0d0b1a"; ctx.fillRect(0,0,W,H);
      if (tr.length < 2) { ctx.fillStyle="#6b7280"; ctx.font="14px system-ui";
        ctx.fillText("COT history building…", 24, H/2); $("ls-meta").textContent=""; return; }
      const plotW=W-padL-padR, plotH=H-padT-padB;
      const xs=tr.map((_,i)=>padL+i/(tr.length-1)*plotW);
      const ys=tr.map((p)=>padT+(1-p.long_pct)*plotH);   // long_pct 0..1, 100% at top
      last._geom={padL,padT,plotW,plotH,W,H,mode:"cot",tr,xs,ys};
      // y grid 0/25/50/75/100%
      ctx.font="11px system-ui"; ctx.textAlign="right";
      for (const gp of [0,0.25,0.5,0.75,1]) { const y=padT+(1-gp)*plotH;
        ctx.strokeStyle= gp===0.5?"rgba(255,255,255,0.22)":"rgba(255,255,255,0.07)";
        ctx.setLineDash(gp===0.5?[4,3]:[]); ctx.lineWidth=1;
        ctx.beginPath(); ctx.moveTo(padL,y); ctx.lineTo(padL+plotW,y); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle="#8b909c"; ctx.fillText((gp*100)+"%", padL-6, y+3); }
      // area + line
      ctx.beginPath(); ctx.moveTo(xs[0],ys[0]); for(let i=1;i<xs.length;i++)ctx.lineTo(xs[i],ys[i]);
      ctx.strokeStyle="#d9b44a"; ctx.lineWidth=1.8; ctx.stroke();
      ctx.lineTo(xs[xs.length-1],padT+plotH); ctx.lineTo(xs[0],padT+plotH); ctx.closePath();
      ctx.fillStyle="rgba(217,180,74,0.10)"; ctx.fill();
      // last point dot
      ctx.fillStyle="#d9b44a"; ctx.beginPath(); ctx.arc(xs[xs.length-1],ys[ys.length-1],3,0,7); ctx.fill();
      // x labels: first + last report date
      ctx.fillStyle="#8b909c"; ctx.font="11px system-ui"; ctx.textAlign="left";
      ctx.fillText(tr[0].report_date, padL, H-10);
      ctx.textAlign="right"; ctx.fillText(tr[tr.length-1].report_date, padL+plotW, H-10);
      ctx.textAlign="center"; ctx.fillStyle="#d9b44a"; ctx.font="bold 11px system-ui";
      ctx.fillText("managed-money / large-spec LONG share, weekly", padL+plotW/2, padT-6);
      $("ls-meta").innerHTML = `<strong>${LABEL[d.coin]||d.coin}</strong> · CFTC COT ${d.cot.category} · `
        + `${tr.length} weekly reports · ${tr[0].report_date} → ${tr[tr.length-1].report_date}`;
    }

    function renderCtx(mode, d) {
      const el = $("ls-ctx"); el.hidden = false;
      if (mode === "cot") {
        const c = d.cot;
        const net = c.net_pct_of_oi;
        const read = net > 8 ? "crowded long" : net < -8 ? "crowded short"
                   : net > 0 ? "leaning long" : net < 0 ? "leaning short" : "flat";
        const tr = c.trend || [];
        let extreme = "";
        if (tr.length >= 12) {
          const nps = tr.map((p)=>p.net_pct).filter((x)=>x!=null);
          const mean = nps.reduce((a,b)=>a+b,0)/nps.length;
          const sd = Math.sqrt(nps.reduce((a,b)=>a+(b-mean)*(b-mean),0)/nps.length) || 1;
          const z = (net - mean)/sd;
          extreme = Math.abs(z) >= 1.5
            ? `<b style="color:#ff6f66">${z>0?"crowded vs":"washed out vs"} its own 3y range</b> (z=${z.toFixed(1)})`
            : `within its normal range (z=${z.toFixed(1)} vs 3y)`;
        }
        el.innerHTML =
          `<div class="ls-card"><div class="ls-card-t">NET POSITIONING</div>`
          + `<div class="ls-card-v" style="color:${net>0?'#3fd07f':net<0?'#ff6f66':'#efefef'}">${net>0?"+":""}${net}% <span style="font-size:.8rem;color:#8b909c">of OI</span></div>`
          + `<div class="ls-card-sub">${c.category} ${read}</div></div>`
          + `<div class="ls-card"><div class="ls-card-t">VS HISTORY</div>`
          + `<div class="ls-card-v" style="font-size:1rem">${extreme || "building…"}</div>`
          + `<div class="ls-card-sub">extremes precede unwinds — crowds max-long into tops, max-short into bottoms</div></div>`
          + `<div class="ls-card"><div class="ls-card-t">OPEN INTEREST <span class="ls-tag">CFTC</span></div>`
          + `<div class="ls-card-v">${fmtNum(c.oi)}</div>`
          + `<div class="ls-card-sub">contracts · ${fmtNum(c.long)} long / ${fmtNum(c.short)} short</div></div>`;
        return;
      }
      // DEX mode: funding + DEX trend + OI-by-venue
      let f = "";
      if (d.funding && d.funding.annualized_pct != null) {
        const a = d.funding.annualized_pct;
        f = `<div class="ls-card-v" style="color:${a>0.05?'#3fd07f':a<-0.05?'#ff6f66':'#efefef'}">${a>0?"+":""}${a.toFixed(2)}%/yr</div>`
          + `<div class="ls-card-sub">${d.funding.read||""}</div>`;
      } else { f = `<div class="ls-card-v" style="color:#6b7280">—</div><div class="ls-card-sub">no perp funding</div>`; }
      const tr = d.trend || [];
      let trendSub = "trend builds as snapshots accrue";
      if (tr.length >= 2) { const dd=(tr[tr.length-1].long_pct-tr[0].long_pct)*100;
        trendSub = `long share ${pct(tr[0].long_pct)} → ${pct(tr[tr.length-1].long_pct)} (${dd>=0?"+":""}${dd.toFixed(1)} pts)`; }
      const oi = d.oi_by_venue || [];
      let oiHtml = `<div class="ls-card-sub">no CEX open interest</div>`;
      if (oi.length) { const mx=Math.max(...oi.map((o)=>o.oi_usd))||1;
        oiHtml = `<div class="ls-oi">` + oi.map((o)=>
          `<div class="ls-oi-row"><span class="ls-oi-name">${o.exchange}</span>`
          + `<span class="ls-oi-barwrap"><span class="ls-oi-bar" style="width:${Math.max(8,(o.oi_usd/mx)*100)}%"></span></span>`
          + `<span class="ls-oi-usd">${fmtUsd(o.oi_usd)}</span></div>`).join("") + `</div>`; }
      el.innerHTML =
        `<div class="ls-card"><div class="ls-card-t">FUNDING · HL <span class="ls-tag">proxy</span></div>${f}</div>`
        + `<div class="ls-card"><div class="ls-card-t">DEX TREND</div><div class="ls-card-v" style="font-size:1rem">${pct((tr[tr.length-1]||{}).long_pct)} long</div><div class="ls-card-sub">${trendSub}</div></div>`
        + `<div class="ls-card"><div class="ls-card-t">OPEN INTEREST BY VENUE <span class="ls-tag">size only</span></div>${oiHtml}</div>`;
    }

    function render(d) {
      last = d; last._geom = null;
      const mode = d.primary_source === "cot" && d.cot ? "cot" : "dex";
      srcline(mode, d);
      if (mode === "cot") {
        const c = d.cot;
        renderHead(c.long_pct, c.short_pct, c.ls_ratio,
          "▲ " + fmtNum(c.long) + " long", "▼ " + fmtNum(c.short) + " short",
          "· contracts · net " + (c.net_pct_of_oi>0?"+":"") + c.net_pct_of_oi + "% OI");
        renderCotChart(d);
      } else {
        const t = d.totals || {};
        renderHead(t.long_pct, t.short_pct, t.ls_ratio,
          "▲ " + fmtUsd(t.long_usd) + " long", "▼ " + fmtUsd(t.short_usd) + " short",
          t.n_positions ? "· " + t.n_positions + " positions" : "");
        renderDexChart(d);
      }
      renderCtx(mode, d);
      $("ls-disclaimer").textContent = mode === "cot"
        ? "CFTC Commitments of Traders — weekly managed-money (commodities) / "
          + "large-speculator (equity-index) futures positioning, reported by the "
          + "CFTC with a ~3-day lag. Positioning context, not financial advice."
        : (d.disclaimer || "");
    }

    function bindHover() {
      const canvas = $("ls-canvas"), tip = $("ls-tip"), wrap = $("ls-wrap");
      const hide = () => tip.style.display = "none";
      const show = (cxp, cyp) => {
        if (!last || !last._geom) { hide(); return; }
        const g = last._geom, rect = canvas.getBoundingClientRect();
        if (!rect.width) { hide(); return; }
        const sx=g.W/rect.width, sy=g.H/rect.height;
        const x=(cxp-rect.left)*sx, y=(cyp-rect.top)*sy;
        if (x<g.padL||x>g.padL+g.plotW||y<g.padT||y>g.padT+g.plotH){hide();return;}
        let html;
        if (g.mode === "cot") {
          let i = Math.round((x-g.padL)/g.plotW*(g.tr.length-1));
          i = Math.max(0, Math.min(g.tr.length-1, i));
          const p = g.tr[i];
          html = `<div><span class="k">${p.report_date}</span></div>`
            + `<div><span class="k">long share</span> <b style="color:#d9b44a">${pct(p.long_pct)}</b></div>`
            + `<div><span class="k">net</span> <b>${p.net_pct>0?"+":""}${p.net_pct}% OI</b></div>`;
        } else {
          const price = g.vmax - (y-g.padT)/g.plotH*g.vspan;
          let best=null,bd=1e18; for (const b of last.buckets){const dd=Math.abs(b.price-price); if(dd<bd){bd=dd;best=b;}}
          if(!best){hide();return;}
          const tot=best.long_usd+best.short_usd;
          html = `<div><span class="k">price</span> <b>${fmtPx(best.price)}</b></div>`
            + `<div><span class="k">long</span> <b style="color:#3fd07f">${fmtUsd(best.long_usd)}</b></div>`
            + `<div><span class="k">short</span> <b style="color:#ff6f66">${fmtUsd(best.short_usd)}</b></div>`
            + (tot>0?`<div><span class="k">long share</span> <b>${pct(best.long_usd/tot)}</b></div>`:"");
        }
        tip.innerHTML = html; tip.style.display="block";
        const wr=wrap.getBoundingClientRect();
        let tx=cxp-wr.left+14, ty=cyp-wr.top+14;
        if (tx+tip.offsetWidth>wrap.clientWidth) tx=cxp-wr.left-tip.offsetWidth-14;
        if (ty+tip.offsetHeight>wrap.clientHeight) ty=cyp-wr.top-tip.offsetHeight-14;
        tip.style.left=Math.max(0,tx)+"px"; tip.style.top=Math.max(0,ty)+"px";
      };
      canvas.addEventListener("mousemove",(e)=>show(e.clientX,e.clientY));
      canvas.addEventListener("mouseleave",hide);
      const onT=(e)=>{if(!e.touches||!e.touches.length)return;e.preventDefault();show(e.touches[0].clientX,e.touches[0].clientY);};
      canvas.addEventListener("touchstart",onT,{passive:false});
      canvas.addEventListener("touchmove",onT,{passive:false});
      canvas.addEventListener("touchend",hide);
    }

    async function load() {
      const my = ++reqId;
      banner("proof-loading", "loading " + (LABEL[coin]||coin) + " long/short…");
      try {
        const r = await fetch(`${API}/charts/long-short/${encodeURIComponent(coin)}?days=${days}`,
          { cache:"no-store", signal: AbortSignal.timeout(20000) });
        if (my !== reqId) return;
        if (!r.ok) { banner("proof-error", "error " + r.status + (last?" — showing previous":"")); return; }
        const d = await r.json();
        if (my !== reqId) return;
        render(d);
        banner("proof-ok", d.primary_source === "cot" ? "CFTC COT · weekly" : "live · real on-chain");
      } catch (e) {
        if (my !== reqId) return;
        banner("proof-error", "fetch failed" + (last?" — showing previous, retrying…":" — retrying…"));
      }
    }

    function start() {
      buildCoins(); bindRange(); bindHover(); sel(); load();
      timer = setInterval(load, REFRESH_MS);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { clearInterval(timer); timer=null; }
        else if (!timer) { load(); timer=setInterval(load, REFRESH_MS); }
      });
      window.addEventListener("resize", () => {
        clearTimeout(resizeT);
        resizeT = setTimeout(() => { if (last) render(last); }, 150);
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
    else start();
  })();
  </script>
</BaseLayout>
