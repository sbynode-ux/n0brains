---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="support & resistance"
  description="n0brains live support/resistance levels overlaid on price — order-book + pivot levels for BTC and ETH free, full coin coverage on Pro."
  ogImage="/og-default.png"
>
  <section class="chart-page">
    <div class="chart-head">
      <a href="/charts" class="back">← charts</a>
      <p class="kicker"><span class="live-dot"></span>Live levels · refreshed every 60s</p>
      <h1>SUPPORT &amp;<br /><span class="accent">RESISTANCE</span></h1>
      <p class="lede">
        Pivot levels detected on <strong>three timeframes</strong> — 15m, 4h and
        1d — overlaid on live price. Thicker lines are higher-timeframe
        structure. <strong>BTC and ETH are free</strong>;
        <a href="/pricing">Pro</a> unlocks every coin we track.
      </p>
    </div>

    <!-- Tabs are built from /charts/levels-coins so the page shows every coin
         the engine tracks (31, not the 5 that used to be hardcoded here) and
         can never drift from the roster again. The BTC/ETH seed keeps the page
         useful with JS still loading or the roster call failing. -->
    <div class="coin-tabs" id="coin-tabs">
      <button class="coin-tab active" data-coin="BTC">BTC</button>
      <button class="coin-tab" data-coin="ETH">ETH</button>
    </div>

    <!-- Range selector. The chart was locked to a 24h window because every
         level the engine produced sat within ~1.5% of spot; now that 4h and 1d
         structure exists, a 24h-only view hides most of the answer. -->
    <div class="range-tabs" id="range-tabs">
      <button class="range-tab" data-range="24h">24h</button>
      <button class="range-tab active" data-range="7d">7d</button>
      <button class="range-tab" data-range="90d">90d</button>
      <button class="range-tab" data-range="1y">1y</button>
    </div>

    <div id="lv-banner" class="status-banner status-loading">
      <span class="dot"></span><span class="banner-text">loading levels…</span>
    </div>

    <div class="panel">
      <div class="panel-head">
        <span class="panel-title" id="lv-title">BTC</span>
        <span class="panel-sub" id="lv-price">—</span>
      </div>
      <div id="lv-chart" class="lv-chart-wrap"><canvas id="lv-canvas"></canvas></div>
      <div id="lv-legend" class="lv-legend"></div>
    </div>

    <p class="meta" id="lv-meta"></p>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  "use strict";
  const API = "https://api.n0brains.com";
  const PUB = API + "/charts/levels/";
  const PRO = API + "/charts/pro/levels/";
  // Range → (candle interval, hours). Each range is roughly 150-400 candles so
  // the canvas stays readable at every zoom.
  const RANGES = {
    "24h": { interval: "15m", hours: 24,        xstep: 4 * 3600,        label: "24h · 15m candles" },
    "7d":  { interval: "1h",  hours: 168,       xstep: 24 * 3600,       label: "7d · 1h candles" },
    "90d": { interval: "4h",  hours: 90 * 24,   xstep: 14 * 86400,      label: "90d · 4h candles" },
    "1y":  { interval: "1d",  hours: 365 * 24,  xstep: 60 * 86400,      label: "1y · 1d candles" },
  };
  let coin = "BTC", range = "7d", candles = [], timer = null, reqId = 0;
  let freeCoins = ["BTC", "ETH"];

  const $ = (id) => document.getElementById(id);
  const jwt = () => localStorage.getItem("auth_token");
  // Server-verified Pro flag (don't trust cached tier — stale after upgrade).
  // null = unknown/not-checked, true/false = server's answer this session.
  let proVerified = null;
  const hasSession = () => !!jwt();
  const fmtPx = (p) => p >= 1000 ? "$" + p.toLocaleString(undefined, { maximumFractionDigits: 0 })
    : "$" + p.toLocaleString(undefined, { maximumFractionDigits: p < 10 ? 4 : 2 });

  function banner(cls, text) {
    const b = $("lv-banner");
    b.className = "status-banner " + cls;
    b.querySelector(".banner-text").textContent = text;
  }

  async function fetchCandles(c) {
    // Candles now come from OUR feed — the same Hyperliquid candles the levels
    // are detected on. Previously CoinGecko, through a hardcoded coin→id map
    // that capped this page at five coins and could disagree with the price
    // the levels were computed from.
    const R = RANGES[range] || RANGES["7d"];
    try {
      const r = await fetch(`${API}/charts/candles/${c}?interval=${R.interval}&hours=${R.hours}`, { cache: "no-store" });
      if (!r.ok) return [];
      const j = await r.json();
      return (j.candles || []).map((k) => ({ t: k.t / 1000, o: k.o, h: k.h, l: k.l, c: k.c }));
    } catch (e) { return []; }
  }

  async function buildCoinTabs() {
    // Roster from the engine, not a list typed into this file.
    try {
      const r = await fetch(API + "/charts/levels-coins", { cache: "no-store" });
      if (!r.ok) return;
      const j = await r.json();
      if (!Array.isArray(j.coins) || !j.coins.length) return;
      freeCoins = j.free_coins || freeCoins;
      const host = $("coin-tabs");
      host.innerHTML = j.coins.map((c) => {
        const free = freeCoins.includes(c);
        return `<button class="coin-tab${c === coin ? " active" : ""}${free ? "" : " pro-coin"}" data-coin="${c}">`
          + c + (free ? "" : ` <span class="lk">🔒</span>`) + `</button>`;
      }).join("");
    } catch (e) { /* keep the server-rendered BTC/ETH seed */ }
  }

  async function fetchLevels(c) {
    // If a session exists, try the Pro endpoint first and let the server decide.
    // 200 → Pro (records proVerified=true); 401/403 → not Pro → fall to public.
    if (hasSession()) {
      try {
        const r = await fetch(PRO + c, { headers: { Authorization: "Bearer " + jwt() }, cache: "no-store" });
        if (r.ok) { proVerified = true; return await r.json(); }
        if (r.status === 401 || r.status === 403) proVerified = false;
      } catch (e) {}
    } else {
      proVerified = false;
    }
    const r = await fetch(PUB + c, { cache: "no-store" });
    return await r.json();
  }

  function render(data) {
    const cv = $("lv-canvas"), ctx = cv.getContext("2d");
    const wrap = $("lv-chart-wrap") || cv.parentElement;
    const W = wrap.clientWidth, H = W < 640 ? 320 : 420;
    cv.width = W * devicePixelRatio; cv.height = H * devicePixelRatio;
    cv.style.width = W + "px"; cv.style.height = H + "px";
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    ctx.clearRect(0, 0, W, H);

    if (data.pro_only) {
      banner("status-unknown", coin + " levels are Pro — BTC/ETH are free");
      $("lv-price").textContent = "";
      drawLocked(ctx, W, H);
      $("lv-legend").innerHTML = `<a class="btn-primary" href="/pricing?utm_source=charts&utm_medium=chart&utm_campaign=levels">Unlock ${coin} with Pro — code RACE →</a>`;
      return;
    }
    if (!data || data.error || !data.current_price) {
      banner("status-unknown", "levels unavailable (" + (data?.detail || data?.error || "fetch failed") + ")");
      return;
    }

    const price = data.current_price;
    $("lv-title").textContent = coin;
    $("lv-price").textContent = fmtPx(price);
    banner("status-up", coin + " · " + fmtPx(price) + " · live S/R");

    const PADL = 10, PADR = 96, PADT = 12, PADB = 30;
    // opaque plot floor — the page's background grid must not bleed through
    ctx.fillStyle = "#0a0d0a"; ctx.fillRect(0, 0, W, H);
    // Merge the near list with the higher-timeframe structure block, deduped by
    // price. all_* is bounded to what is close to spot; `structure` carries the
    // 4h/1d levels that are the whole point of zooming out — without this the
    // 90d and 1y views would draw a wide candle window with only intraday
    // levels on it.
    const dedupe = (arr) => {
      const out = [];
      for (const l of arr) {
        if (!l || !l.price) continue;
        if (out.some((o) => Math.abs(o.price - l.price) / l.price < 0.0005)) continue;
        out.push(l);
      }
      return out;
    };
    const struct = data.structure || {};
    const res = dedupe([...(data.all_resistance || []), ...(struct.resistance || [])]);
    const sup = dedupe([...(data.all_support || []), ...(struct.support || [])]);
    // measured outcome ledger (ops #87): show the raw record when the level
    // has enough completed tests — never a composite score
    const statTag = (l) => (l && l.win_rate != null && l.tests)
      ? `${l.bounces}/${l.tests} held · ${Math.round(l.win_rate)}%` : "";
    const allLevels = [...res, ...sup].map((l) => l.price);
    let lo = Math.min(price, ...candles.map((k) => k.l), ...allLevels.filter(Boolean));
    let hi = Math.max(price, ...candles.map((k) => k.h), ...allLevels.filter(Boolean));
    if (!isFinite(lo) || !isFinite(hi) || lo === hi) { lo = price * 0.95; hi = price * 1.05; }
    const pad = (hi - lo) * 0.06; lo -= pad; hi += pad;
    const Y = (p) => PADT + (1 - (p - lo) / (hi - lo)) * (H - PADT - PADB);

    // y axis: round-step gridlines + faint right-gutter ticks (level pills
    // draw over them opaquely afterwards — pills win any overlap)
    ctx.font = "10px 'Space Mono', monospace";
    const niceStep = (range, target) => {
      const raw = range / target, mag = Math.pow(10, Math.floor(Math.log10(raw)));
      for (const m of [1, 2, 2.5, 5, 10]) if (raw <= m * mag) return m * mag;
      return 10 * mag;
    };
    const stepY = niceStep(hi - lo, 6);
    for (let p = Math.ceil(lo / stepY) * stepY; p < hi; p += stepY) {
      const y = Y(p);
      ctx.strokeStyle = "rgba(255,255,255,0.06)"; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(PADL, y); ctx.lineTo(W - PADR, y); ctx.stroke();
      ctx.fillStyle = "rgba(255,255,255,0.38)"; ctx.textAlign = "left";
      ctx.fillText(fmtPx(p), W - PADR + 6, y + 3);
    }

    // x axis + candles
    if (candles.length) {
      const t0 = candles[0].t, t1 = candles[candles.length - 1].t;
      const X = (t) => PADL + ((t - t0) / (t1 - t0 || 1)) * (W - PADL - PADR);
      // tick spacing follows the selected range (was hardcoded to 4h, which on
      // a 1y window would draw ~2200 gridlines)
      const R = RANGES[range] || RANGES["7d"];
      const stepX = R.xstep;
      const intraday = R.hours <= 48;
      for (let t = Math.ceil(t0 / stepX) * stepX; t <= t1; t += stepX) {
        const x = X(t);
        ctx.strokeStyle = "rgba(255,255,255,0.045)";
        ctx.beginPath(); ctx.moveTo(x, PADT); ctx.lineTo(x, H - PADB); ctx.stroke();
        ctx.fillStyle = "rgba(255,255,255,0.38)"; ctx.textAlign = "center";
        const d = new Date(t * 1000);
        ctx.fillText(
          intraday ? d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
                   : d.toLocaleDateString([], { month: "short", day: "numeric" }),
          x, H - PADB + 16);
      }
      const cw = Math.max(2, (W - PADL - PADR) / candles.length - 2);
      ctx.lineWidth = 1.4;
      for (const k of candles) {
        const up = k.c >= k.o; ctx.strokeStyle = ctx.fillStyle = up ? "#26d07c" : "#ef4444";
        const x = X(k.t) + cw / 2;
        ctx.beginPath(); ctx.moveTo(x, Y(k.h)); ctx.lineTo(x, Y(k.l)); ctx.stroke();
        ctx.fillRect(X(k.t), Y(Math.max(k.o, k.c)), cw, Math.max(2, Math.abs(Y(k.o) - Y(k.c))));
      }
      ctx.lineWidth = 1;
    }

    // levels + current price: dashed lines at true y, axis PILLS collision-
    // resolved down the right gutter (TradingView-style)
    ctx.font = "11px 'Space Mono', monospace";
    // A level's timeframe is drawn, not just carried: higher-timeframe levels
    // get a heavier, longer-dashed line and their tf on the stat line, because
    // "1.0157 (15m, 4 tests)" and "1.12 (1d, 40 tests)" are not the same claim
    // and must not look alike.
    const TF_STYLE = {
      "1d":  { dash: [10, 4], width: 2,   alpha: 0.85 },
      "4h":  { dash: [7, 4],  width: 1.6, alpha: 0.7 },
      "15m": { dash: [4, 4],  width: 1,   alpha: 0.45 },
    };
    const styleFor = (l) => TF_STYLE[l && l.timeframe] || TF_STYLE["15m"];
    const tfTag = (l) => {
      const parts = [];
      if (l && l.timeframe) parts.push(l.timeframe);
      const s = statTag(l);
      if (s) parts.push(s);
      return parts.join(" · ");
    };
    const items = [
      ...res.map((l) => ({ p: l.price, color: "#ef4444", stat: tfTag(l), st: styleFor(l) })),
      ...sup.map((l) => ({ p: l.price, color: "#00ff41", stat: tfTag(l), st: styleFor(l) })),
      { p: price, color: "#efefef", isPrice: true },
    ].filter((it) => it.p > lo && it.p < hi).sort((a, b) => Y(a.p) - Y(b.p));
    // Pills are pushed apart so they never overlap; the stat line sits ABOVE
    // its pill, so it only gets drawn when the gap to the pill above actually
    // leaves room for it. With one timeframe the levels were far enough apart
    // that this never mattered; with three they cluster near spot and the
    // stats printed on top of each other into an unreadable smear.
    let lastY = -99;
    for (const it of items) {
      it.y = Math.max(Y(it.p), lastY + 16);
      it.showStat = (it.y - lastY) >= 26;
      lastY = it.y;
    }
    for (const it of items) {
      const y = Y(it.p);
      ctx.strokeStyle = it.color;
      ctx.globalAlpha = it.isPrice ? 0.9 : (it.st ? it.st.alpha : 0.5);
      ctx.setLineDash(it.isPrice ? [2, 3] : (it.st ? it.st.dash : [5, 4]));
      ctx.lineWidth = it.isPrice ? 1 : (it.st ? it.st.width : 1);
      ctx.beginPath(); ctx.moveTo(PADL, y); ctx.lineTo(W - PADR, y); ctx.stroke();
      ctx.setLineDash([]); ctx.globalAlpha = 1; ctx.lineWidth = 1;
      if (it.stat && it.showStat) {
        ctx.fillStyle = "rgba(255,255,255,0.5)";
        ctx.font = "9.5px 'Space Mono', monospace"; ctx.textAlign = "right";
        // anchor to the RESOLVED pill position, not the true y — otherwise the
        // stat drifts away from the pill it describes as pills get pushed down
        ctx.fillText(it.stat, W - PADR - 8, it.y - 5);
        ctx.font = "11px 'Space Mono', monospace";
      }
      const label = fmtPx(it.p), tw = ctx.measureText(label).width;
      ctx.fillStyle = it.color;
      ctx.beginPath();
      ctx.roundRect(W - PADR + 2, it.y - 9, tw + 12, 17, 3);
      ctx.fill();
      ctx.fillStyle = "#000"; ctx.textAlign = "left";
      ctx.fillText(label, W - PADR + 8, it.y + 4);
    }

    const tfs = (data.timeframes || []).join(" · ");
    $("lv-legend").innerHTML =
      `<span class="lg"><span class="lg-line" style="background:#00ff41"></span>support</span>` +
      `<span class="lg"><span class="lg-line" style="background:#ef4444"></span>resistance</span>` +
      `<span class="lg"><span class="lg-line" style="background:#efefef"></span>price</span>` +
      `<span class="lg muted">${(RANGES[range] || RANGES["7d"]).label}</span>` +
      (tfs ? `<span class="lg muted">levels from ${tfs} — thicker line = higher timeframe</span>` : "") +
      (proVerified ? `<span class="lg pro-on">PRO ✓ all coins</span>` : `<span class="lg muted">BTC/ETH free · <a href="/pricing">Pro for all coins</a></span>`);
    if (data.disclaimer) $("lv-meta").textContent = data.disclaimer;
  }

  function drawLocked(ctx, W, H) {
    ctx.fillStyle = "#0a0a0a"; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = "#707070"; ctx.font = "48px 'Space Mono', monospace"; ctx.textAlign = "center";
    ctx.fillText("🔒", W / 2, H / 2 - 10);
    ctx.font = "14px 'Space Mono', monospace";
    ctx.fillText(coin + " levels are a Pro feature", W / 2, H / 2 + 28);
  }

  async function load() {
    const my = ++reqId;
    banner("status-loading", "loading " + coin + " levels…");
    const isMajor = coin === "BTC" || coin === "ETH";
    // Fetch levels FIRST (this also resolves proVerified), then decide candles.
    let data;
    try { data = await fetchLevels(coin); }
    catch (e) { if (my === reqId) render({ error: String(e) }); return; }
    if (my !== reqId) return;
    candles = (isMajor || proVerified) && !data.pro_only ? await fetchCandles(coin) : [];
    if (my !== reqId) return;
    render(data);
  }

  document.getElementById("coin-tabs").addEventListener("click", (e) => {
    const b = e.target.closest(".coin-tab"); if (!b) return;
    document.querySelectorAll(".coin-tab").forEach((t) => t.classList.remove("active"));
    b.classList.add("active"); coin = b.dataset.coin; load();
  });
  document.getElementById("range-tabs").addEventListener("click", (e) => {
    const b = e.target.closest(".range-tab"); if (!b) return;
    document.querySelectorAll(".range-tab").forEach((t) => t.classList.remove("active"));
    b.classList.add("active"); range = b.dataset.range; load();
  });
  addEventListener("resize", () => { clearTimeout(window._lvrz); window._lvrz = setTimeout(load, 200); });
  buildCoinTabs().then(load); setInterval(load, 60000);
})();
</script>

<style>
  .chart-page { max-width: var(--max-width-app); margin: 0 auto; padding: 2.4rem 0 4rem; }
  .chart-head { margin-bottom: 1.4rem; }
  .back { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .kicker { font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase;
    letter-spacing: 0.2em; color: var(--accent); margin: 1rem 0; display: flex; align-items: center; gap: 0.6rem; }
  .chart-head h1 { font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 0.92; color: var(--text-heading); margin-bottom: 1rem; }
  .accent { color: var(--accent); }
  .lede { font-size: 1rem; max-width: 660px; color: var(--text); }
  .lede a { color: var(--accent); }

  .coin-tabs { display: flex; gap: 0.5rem; margin-bottom: 0.7rem; flex-wrap: wrap; }
  .range-tabs { display: flex; gap: 0.4rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
  .range-tab { font-family: var(--font-mono); font-size: 0.76rem; padding: 0.32rem 0.8rem;
    background: transparent; color: var(--text-muted); border: 1px solid var(--border);
    border-radius: 2px; cursor: pointer; }
  .range-tab:hover { color: var(--text-heading); border-color: var(--border-accent); }
  .range-tab.active { color: var(--accent); border-color: var(--accent); font-weight: 700; }
  @media (pointer: coarse) { .range-tab { min-height: 36px; } }
  .coin-tab { font-family: var(--font-mono); font-size: 0.84rem; padding: 0.45rem 1rem;
    background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border);
    border-radius: var(--radius-sm); cursor: pointer; transition: 0.15s; }
  .coin-tab:hover { color: var(--text-heading); border-color: var(--border-accent); }
  .coin-tab.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 700; }
  .coin-tab .lk { font-size: 0.7rem; opacity: 0.7; }

  .status-banner { display: flex; align-items: center; gap: 12px; padding: 14px 18px;
    border-radius: var(--radius); font-family: var(--font-mono); font-size: 0.86rem;
    margin-bottom: 1.3rem; border: 1px solid var(--border); }
  .status-banner .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--text-muted); }
  .status-up { border-color: rgba(0,255,65,0.3); }
  .status-up .dot { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  .status-loading .dot { background: var(--accent); animation: blink 1.4s infinite; }

  .panel { border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); padding: 1.2rem 1.4rem 1.4rem; }
  .panel-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  .panel-title { font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-heading);
    text-transform: uppercase; letter-spacing: 0.08em; }
  .panel-sub { font-family: var(--font-mono); font-size: 0.95rem; color: var(--accent); }
  .lv-chart-wrap { width: 100%; }
  #lv-canvas { display: block; width: 100%; }
  .lv-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 0.9rem;
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }
  .lg { display: inline-flex; align-items: center; gap: 0.4rem; }
  .lg-line { width: 16px; height: 2px; display: inline-block; }
  .lg.pro-on { color: var(--accent); } .lg.muted a { color: var(--accent); }

  .meta { color: var(--text-muted); font-size: 0.78rem; font-family: var(--font-mono); margin-top: 1rem; }
  .btn-primary { background: var(--accent); color: #000; font-family: var(--font-mono); font-weight: 700;
    padding: 0.6rem 1.2rem; border-radius: var(--radius-sm); text-decoration: none; display: inline-block; transition: filter 0.15s; }
  .btn-primary:hover { filter: brightness(1.12); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 8px var(--accent); display: inline-block; animation: blink 2s infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }

  /* touch + mobile */
  @media (pointer: coarse) { .coin-tab { min-height: 40px; padding: 0.6rem 1rem; } }
  @media (max-width: 640px) {
    .chart-head h1 { font-size: 2.4rem; }
    .coin-tab { font-size: 0.8rem; padding: 0.5rem 0.7rem; }
    #lv-canvas { height: 320px; }
    .lv-legend { font-size: 0.72rem; gap: 0.6rem; }
  }
</style>
